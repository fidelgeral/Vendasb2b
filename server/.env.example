# Copie este ficheiro para ".env" e preencha os valores reais.
# NUNCA envie o ficheiro ".env" para o GitHub (já está no .gitignore).

# Connection string do Postgres (Neon). Exemplo:
# postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/vendasb2b?sslmode=require
DATABASE_URL=

# Segredo usado para assinar as sessões (tokens). Use um texto longo e aleatório.
JWT_SECRET=

# Conta do super-admin (Dino) — usada apenas na primeira vez (npm run seed:super)
SUPER_ADMIN_EMAIL=dino@vendasb2b.co.mz
SUPER_ADMIN_PASSWORD=

# URL pública do frontend, para permitir pedidos a partir dele (CORS).
# Em desenvolvimento local:
CORS_ORIGIN=http://localhost:5173

PORT=4000
